DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

CLERK_ISSUER=https://YOUR_CLERK_ISSUER
# Optional when CLERK_ISSUER is set:
# CLERK_JWKS_URL=https://YOUR_CLERK_ISSUER/.well-known/jwks.json

WATCHIT_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
WATCHIT_ANTHROPIC_MODEL=claude-3-5-sonnet-latest

WATCHIT_OLLAMA_MODEL=llama3.1
WATCHIT_OLLAMA_BASE_URL=http://localhost:11434

WATCHIT_PROCESSING_MODE=async
WATCHIT_EMBEDDED_AGENT_WORKER=true
WATCHIT_AGENT_WORKER_POLL_INTERVAL=0.05

WATCHIT_URL_DECISION_CACHE_ENABLED=true
WATCHIT_URL_DECISION_CACHE_TTL_SECONDS=86400
WATCHIT_URL_DECISION_CACHE_MIN_CONFIDENCE=0.85

WATCHIT_LOG_LEVEL=INFO
WATCHIT_AGENT_TRACE_FILES=false

WATCHIT_ENABLE_OCR=true
WATCHIT_SAVE_SCREENSHOTS=false
