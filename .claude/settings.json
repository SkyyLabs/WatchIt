{
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(.venv/bin/python:*)",
      "Bash(.venv/bin/pip:*)",
      "Bash(.venv/bin/alembic:*)",
      "Bash(.venv/bin/uvicorn:*)",
      "Bash(.venv/bin/pytest:*)",
      "Bash(python -m compileall:*)",
      "Bash(python -m pytest:*)",
      "Bash(pytest:*)",
      "Bash(npm run:*)",
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npm --workspace:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(grep:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./apps/dashboard/.env.local)",
      "Bash(alembic downgrade:*)",
      "Bash(.venv/bin/alembic downgrade:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-destructive.py\""
          }
        ]
      }
    ]
  }
}
